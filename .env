# Puertos del host para docker compose. Cámbialos si alguno está ocupado.
# docker compose los lee automáticamente. Tras cambiar API_PORT o WEB_PORT,
# reconstruye con `docker compose up --build` (la URL de la API se embebe en el
# panel en tiempo de build).

# Puerto del host para la API .NET (Swagger en http://localhost:${API_PORT}/swagger).
API_PORT=5080

# Puerto del host para el panel Next.js (http://localhost:${WEB_PORT}).
WEB_PORT=3000

# Puerto del host para PostgreSQL (solo inspección con un cliente de BD).
DB_PORT=5433
